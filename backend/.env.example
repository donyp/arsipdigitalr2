# ============================================
# Pusat Arsip Anka - Backend Environment
# ============================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# DO NOT COMMIT .env FILE TO GIT

# ============================================
# Pusat Arsip Anka - Backend Environment
# ============================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# DO NOT COMMIT .env FILE TO GIT

# ============================================
# CRITICAL - Database Configuration
# ============================================
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# CRITICAL - Authentication
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-random-256-bit-hex-string-here
JWT_EXPIRES_IN=24h

# ============================================
# Deployment Configuration
# ============================================
PORT=5000
NODE_ENV=production

# ============================================
# RECOMMENDED - Session & Security
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=your-random-base64-string-here

# ============================================
# CRITICAL - Cloudflare R2 Configuration
# ============================================
# Get these from Cloudflare R2 console: https://dash.cloudflare.com
# 1. Account ID: Found in Cloudflare dashboard (copy icon at bottom-left)
# 2. Create API token: R2 API (with bucket access)
#    - Account ID
#    - Access Key ID
#    - Secret Access Key
CLOUDFLARE_ACCOUNT_ID=your-account-id-here
CLOUDFLARE_ACCESS_KEY_ID=your-access-key-id-here
CLOUDFLARE_ACCESS_KEY_SECRET=your-secret-access-key-here
CLOUDFLARE_R2_BUCKET=arsip-anka

# ============================================
# Notifications (Optional)
# ============================================
# Get from Fonnte integration dashboard
FONNTE_TOKEN=your-fonnte-token-here

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=104857600
UPLOAD_TEMP_PATH=./backend/tmp
DOWNLOAD_CACHE_PATH=./backend/download-cache
SYNC_QUEUE_PATH=./data/storage-sync-queue.json
SYNC_STATUS_PATH=./data/storage-sync-status.json

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info
LOG_PATH=./logs

# ============================================
# CORS Configuration
# ============================================
# Set to specific origins in production: https://example.com,https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================
# Auto-Logout Configuration
# ============================================
# Time when all users are automatically logged out (HH:MM format, 24-hour)
# Example: 18:00 = 6 PM, 17:00 = 5 PM, 00:00 = midnight
# Default: 00:00 (Midnight) - Maximum security
# Users will see a 5-minute warning before automatic logout
AUTO_LOGOUT_TIME=00:00
